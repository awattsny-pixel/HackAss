{
  "name": "hackass",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 5",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --test tests/*.test.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "smoke": "node tests/smoke/run.mjs",
    "db:test": "node scripts/db-test.mjs",
    "probe:server-boundary": "node scripts/probe-server-boundary.mjs",
    "scan:gitleaks": "node scripts/scan-gitleaks.mjs",
    "install:gitleaks": "node scripts/install-gitleaks.mjs",
    "db:test:auth": "node scripts/db-test.mjs --auth-spikes",
    "install:supabase-cli": "node scripts/install-supabase-cli.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.4.2",
    "next": "^16.3.8",
    "node-fetch": "^2.7.0",
    "postcss": "^8.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-player": "^2.14.0",
    "server-only": "0.0.1",
    "tailwindcss": "^3.3.0",
    "uuid": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "js-yaml": "^4.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0 <23"
  }
}
